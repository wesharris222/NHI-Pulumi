# ============================================================================
# Saviynt + Pulumi Demo — gitignore
# ============================================================================

# ============================================================================
# SECRETS — NEVER COMMIT
# ============================================================================
.env
.env.local
.env.*.local
*.env
!*.env.example
!.env.example

# Saviynt-specific secrets accidentally saved
saviynt_creds.*
*saviynt-secret*
*saviynt-password*

# AWS
.aws/
aws-credentials*
*.pem
!example.pem

# SSH keys (Pulumi may emit these as outputs during testing)
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub
*.key
!*.example.key

# HMAC and other shared secrets
hmac.txt
hmac_secret*
shared_secret*

# Bootstrap credential files
bootstrap.*
!bootstrap.example.*

# ============================================================================
# PULUMI
# ============================================================================
# State files (if using local backend during testing)
.pulumi/
*.pulumi-backup

# Pulumi stack secrets (if accidentally written to disk)
Pulumi.*.yaml.bak

# ============================================================================
# PYTHON
# ============================================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
.venv/
env/
ENV/
.env-venv/

# pytest
.pytest_cache/
.coverage
htmlcov/
.tox/

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# ============================================================================
# NODE / TYPESCRIPT (in case Pulumi project switches languages)
# ============================================================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.tsbuildinfo

# ============================================================================
# IDE
# ============================================================================
.vscode/
!.vscode/settings.json.example
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ============================================================================
# LOGS
# ============================================================================
*.log
logs/
broker.log
pulumi.log
saviynt.log

# ============================================================================
# TEMPORARY / SCRATCH FILES
# ============================================================================
tmp/
temp/
scratch/
*.tmp
*.bak
*.swp

# Test response captures (may contain real Saviynt data during dev)
test-responses/
captured-responses/
*.response.json

# ============================================================================
# DEMO RECORDING / SCREENSHOTS (large binaries, keep separate)
# ============================================================================
recordings/
screenshots/raw/
*.mov
*.mp4
*.webm

# ============================================================================
# OS
# ============================================================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
desktop.ini

# Local Python venv used during development
.venv/

# Claude Code per-machine settings (not source-of-truth)
.claude/settings.local.json

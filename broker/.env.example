# =============================================================================
# Broker bootstrap configuration
# Copy to broker/.env and fill in real values. NEVER commit .env.
# =============================================================================

# ---- Saviynt connection (REQUIRED) ------------------------------------------
# These three are also accepted under the legacy names already exported on
# the Ubuntu broker host: SavURL, SavAPIUser, SavAPIPass. If those env vars
# are present in your shell, LEAVE THE CANONICAL LINES BELOW COMMENTED —
# python-dotenv will inject any uncommented value into the process env and
# the broker prefers canonical over legacy, so an uncommented placeholder
# here will override your real SavURL/SavAPIUser/SavAPIPass.
#
# Uncomment and fill in only if you do NOT have the legacy vars exported.
#SAVIYNT_BASE_URL=https://your-tenant.saviyntcloud.com
#SAVIYNT_USERNAME=svc-pulumi-broker
#SAVIYNT_PASSWORD=replace-me
SAVIYNT_VERIFY_TLS=true

# ---- HMAC shared secret (REQUIRED) ------------------------------------------
# Generate with: scripts/gen_hmac_secret.sh
# Same value goes in GitHub repo secret BROKER_HMAC_SECRET.
BROKER_HMAC_SECRET=replace-me-with-64-hex-chars
BROKER_HMAC_MAX_SKEW_SECONDS=300

# ---- Saviynt API paths ------------------------------------------------------
# Defaults match a standard EIC tenant. Override only if your tenant differs.
# Confirmed against ValidatebySPN-clean.py:
PATH_LOGIN=/ECM/api/login
PATH_GET_ACCOUNTS=/ECM/api/v5/getAccounts
PATH_LLT=/ECM/oauth/access_token_withissuer
PATH_CHECKOUT=/ECMv6/api/pam/account/checkout
# To confirm against tenant in Phase 5:
PATH_GET_USER=/ECM/api/v5/getUser
PATH_CHECK_ENTITLEMENT=/ECM/api/v5/checkUserAccess
PATH_CHECKIN=/ECMv6/api/pam/account/checkin
PATH_CREATE_REQUEST=/ECM/api/v5/createUserAccessRequest
PATH_REQUEST_STATUS=/ECMv6/api/v5/fetchRequestStatus
PATH_CREATE_ACCOUNT=/ECM/api/v5/createAccount
PATH_UPDATE_ACCOUNT=/ECM/api/v5/updateAccount

# ---- Saviynt object names this demo expects ---------------------------------
APP_NAME=Pulumi-Pipeline-AWS
ENT_DEPLOY_DEV=Deploy-EC2-Dev
ENT_DEPLOY_PROD=Deploy-EC2-Prod
PAM_ENDPOINT_AWS=AWS-IAM-Endpoint
PAM_ENDPOINT_EC2=EC2-Instances-Endpoint
PAM_ACCOUNT_AWS_IAM=pulumi-deployer

# ---- NHI metadata custom-property mapping -----------------------------------
# Which Saviynt account customproperty<N> field holds each piece of NHI metadata.
# Confirm against tenant config in Phase 4.
CP_OWNER=customproperty1
CP_ENVIRONMENT=customproperty2
CP_APPLICATION=customproperty3
CP_REQUESTER=customproperty4
CP_INSTANCE_ID=customproperty5
CP_PUBLIC_IP=customproperty6

# ---- Behavior knobs ---------------------------------------------------------
PAM_CHECKOUT_TTL_MIN=30
PAM_MAX_POLL_ATTEMPTS=30
PAM_POLL_INTERVAL_SECS=5
APPROVAL_POLL_TIMEOUT=1800
APPROVAL_POLL_INTERVAL=30
SAVIYNT_REQUEST_TIMEOUT=30

# ---- Server -----------------------------------------------------------------
BROKER_LISTEN_HOST=127.0.0.1
BROKER_LISTEN_PORT=18443
BROKER_LOG_LEVEL=INFO
